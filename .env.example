# ─────────────────────────────────────────────────────────────
# FIREBASE — replace with your real project's config values
# Firebase Console → Project settings → General → Your apps → SDK setup
# Copy this file to ".env" and fill in the real values.
# As long as VITE_FIREBASE_API_KEY stays "YOUR_FIREBASE_API_KEY",
# the app automatically runs in MOCK MODE (localStorage) so every
# feature works out of the box with no backend.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# ─────────────────────────────────────────────────────────────
# WHATSAPP — the number the floating chat button and booking
# confirmations deep-link to, in international format, no "+".
# ─────────────────────────────────────────────────────────────
VITE_WHATSAPP_NUMBER=919000000000

# ─────────────────────────────────────────────────────────────
# GOOGLE MAPS — used for the embedded map. A plain embed URL
# works with no key; add a key only if you want the JS Maps SDK.
# ─────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps?q=Koregaon+Park,Pune&output=embed

# ─────────────────────────────────────────────────────────────
# INSTAGRAM — Meta Graph API token for the live feed (optional).
# Without it, the Instagram section shows the curated placeholder grid.
# ─────────────────────────────────────────────────────────────
VITE_INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_GRAPH_API_TOKEN
VITE_INSTAGRAM_HANDLE=aurabeautylounge

# ─────────────────────────────────────────────────────────────
# ANTHROPIC — used ONLY server-side by /api/booking-agent.js
# (the Vercel serverless function behind the AI booking concierge).
# NEVER prefix this with VITE_ — it must stay off the client bundle.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
